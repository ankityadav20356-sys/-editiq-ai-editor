{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editiq-ai-editor/schema/edit_plan.schema.json",
  "title": "EditIQ Edit Plan",
  "description": "Deterministic instructions generated by EditIQ for the video rendering engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "style_profile": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "captions",
          "color",
          "audio",
          "motion",
          "broll"
        ]
      }
    },
    "caption": {
      "$ref": "#/$defs/caption"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "motion": {
      "$ref": "#/$defs/motion"
    },
    "broll": {
      "$ref": "#/$defs/broll"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transcript_segment"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "string"
        },
        "reference_video": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "transcript",
            "audio",
            "manual"
          ]
        },
        "style_profile": {
          "type": "string"
        },
        "word_level_timing": {
          "type": "boolean"
        },
        "highlight_words": {
          "type": "boolean"
        },
        "position_mode": {
          "type": "string",
          "enum": [
            "fixed",
            "below_chin",
            "safe_area",
            "reference"
          ]
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "preset": {
          "type": "string"
        },
        "exposure": {
          "type": "number"
        },
        "contrast": {
          "type": "number"
        },
        "saturation": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "tint": {
          "type": "number"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "noise_reduction": {
          "type": "boolean"
        },
        "eq": {
          "type": "boolean"
        },
        "compression": {
          "type": "boolean"
        },
        "loudness_normalization": {
          "type": "boolean"
        },
        "music": {
          "type": "boolean"
        },
        "sound_effects": {
          "type": "boolean"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "punch_ins": {
          "type": "boolean"
        },
        "transitions": {
          "type": "boolean"
        },
        "motion_graphics": {
          "type": "boolean"
        }
      }
    },
    "broll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broll_item"
          }
        }
      }
    },
    "broll_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "query"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "query": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media",
        "duration"
      ],
      "properties": {
        "media": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "transcript_word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number"
        }
      }
    },
    "transcript_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcript_word"
          }
        }
      }
    },
    "op_cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end"
      ],
      "properties": {
        "type": {
          "const": "cut"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "op_caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end",
        "text"
      ],
      "properties": {
        "type": {
          "const": "caption"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "word_level_timing": {
          "type": "boolean"
        }
      }
    },
    "op_emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end",
        "word"
      ],
      "properties": {
        "type": {
          "const": "emphasis"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "word": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "op_zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end"
      ],
      "properties": {
        "type": {
          "const": "zoom"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 3
        }
      }
    },
    "op_broll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end",
        "query"
      ],
      "properties": {
        "type": {
          "const": "broll"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "op_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "style"
      ],
      "properties": {
        "type": {
          "const": "transition"
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "style": {
          "type": "string"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "caption",
            "emphasis",
            "zoom",
            "broll",
            "transition"
          ]
        }
      }
    }
  }
}
