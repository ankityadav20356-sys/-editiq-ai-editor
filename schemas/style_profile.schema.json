{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editiq-ai-editor/schema/style_profile.schema.json",
  "title": "EditIQ Style Profile",
  "description": "Reusable visual and audio style specification extracted from a reference video.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_id",
    "version",
    "confidence",
    "caption"
  ],
  "properties": {
    "style_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "caption": {
      "$ref": "#/$defs/caption"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "motion": {
      "$ref": "#/$defs/motion"
    }
  },
  "$defs": {
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_family": {
          "type": "string"
        },
        "font_weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "size_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "letter_spacing": {
          "type": "number"
        },
        "line_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "max_words_per_line": {
          "type": "integer",
          "minimum": 1
        },
        "margin_left": {
          "type": "number",
          "minimum": 0
        },
        "margin_right": {
          "type": "number",
          "minimum": 0
        },
        "margin_vertical": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "safe_area": {
          "$ref": "#/$defs/safe_area"
        },
        "stroke": {
          "$ref": "#/$defs/effect"
        },
        "shadow": {
          "$ref": "#/$defs/shadow"
        },
        "glow": {
          "$ref": "#/$defs/glow"
        },
        "animation": {
          "$ref": "#/$defs/animation"
        },
        "word_styles": {
          "description": "Named word-level style overrides. A caption word may reference one of these names via its own 'style' field. SUPPORTED NOW by renderer/caption_renderer.py: fill, scale, font_weight. 'animation' on a word_style is schema-ready but not yet rendered per-word (only the caption-level animation is currently used).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/word_style"
          }
        },
        "phrase_styles": {
          "description": "Named phrase-level (multi-word run) style overrides. SCHEMA-READY BUT NOT YET RENDERED \u2014 reserved for a future renderer capability. Present so profiles can be authored/validated ahead of renderer support without breaking anything.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/word_style"
          }
        }
      }
    },
    "word_style": {
      "description": "A single named style override applicable to a word (now) or a phrase (schema-ready). All fields optional; unspecified fields fall back to the caption's base style.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "font_weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "animation": {
          "$ref": "#/$defs/animation"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "safe_area": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "width_px": {
          "type": "number",
          "minimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur_px": {
          "type": "number",
          "minimum": 0
        },
        "offset_x": {
          "type": "number"
        },
        "offset_y": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "glow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "blur_px": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "easing": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "type": "number"
        },
        "contrast": {
          "type": "number"
        },
        "saturation": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "tint": {
          "type": "number"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noise_reduction": {
          "type": "boolean"
        },
        "eq": {
          "type": "boolean"
        },
        "compression": {
          "type": "boolean"
        },
        "loudness_target_lufs": {
          "type": "number"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_transition": {
          "type": "string"
        },
        "default_easing": {
          "type": "string"
        },
        "default_zoom_strength": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
